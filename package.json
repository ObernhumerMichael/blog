{
  "name": "ledger",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal technical blog — Astro static site, built to the Ledger design system.",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:svelte": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "check:astro": "astro check",
    "check:css": "stylelint \"src/**/*.css\" \"src/**/*.astro\"",
    "check:format": "prettier --check .",
    "check:fonts": "node scripts/verify-fonts.mjs",
    "check:tokens": "node scripts/verify-tokens.mjs",
    "check:content": "node --test tests/invariants/*.test.ts",
    "check:e2e": "KEEP_DEV_PAGES=1 astro build --outDir dist-e2e && astro preview --outDir dist-e2e --background && (playwright test; s=$?; astro preview stop; exit $s)",
    "check:links": "lychee 'dist/**/*.html'",
    "format": "prettier --write .",
    "verify": "pnpm run check:format && pnpm run check:astro && pnpm run check:css && pnpm run check:tokens && pnpm run check:fonts && pnpm run check:content && pnpm run check:e2e && pnpm run check:svelte"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@shikijs/transformers": "^4.4.3",
    "astro": "^7.2.6",
    "mdast-util-to-string": "^4.0.0",
    "remark-directive": "^4.0.0",
    "sharp": "^0.35.4",
    "svelte": "^5.57.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "gray-matter": "^4.0.3",
    "postcss-html": "^2.0.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "shiki": "^4.4.3",
    "stylelint": "^17.14.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3"
  }
}
