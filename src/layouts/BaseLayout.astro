---
// BaseLayout — the document shell every page renders through.
//
// AD-01 / DESIGN_SYSTEM.md §17.4: ViewTransitions / ClientRouter must NEVER
// be added to this file. Navigation is a full document load; page
// transitions do not exist in this system. This is the file where someone
// would reflexively add it, which is why the warning lives here.

import { SITE_URL } from '../consts';
import { COPY } from '../copy';
import '../styles/global.css';
import Masthead from '../components/chrome/Masthead.astro';
import Footer from '../components/chrome/Footer.astro';

// `?raw` + `is:inline` below: verified in Phase 1.5 that this is the only
// way the script reaches the page byte-for-byte as a blocking, non-deferred
// inline script. Without `is:inline`, Astro rewrites it to
// `<script type="module">`, which is deferred by spec — meaning the theme
// decision could run AFTER first paint, which is exactly the flash this
// script exists to prevent.
import themeInitSource from '../lib/theme-init.js?raw';

interface Props {
  /** Page title. Composed as "{title} · {COPY.site.name}"; omit on the homepage. */
  title?: string;
  description?: string;
  /**
   * OD-05 German preparation. Not cosmetic: §2.5 relies on automatic
   * hyphenation for long titles, and hyphenation dictionaries are
   * language-keyed — so this attribute has to be correct per-page before
   * any German content exists, not retrofitted afterwards.
   */
  lang?: string;
  /** Phase 5.6 — forwarded to Masthead's own under-1280 progress bar. Only
   * ProseLayout.astro passes this; every other page leaves it off. */
  progress?: boolean;
}

const { title, description, lang = 'en', progress = false } = Astro.props;

const pageTitle = title ? `${title} · ${COPY.site.name}` : COPY.site.name;
const canonical = new URL(Astro.url.pathname, SITE_URL);
// One static site-wide card (content-plan step 6) — not a per-page
// generator. §21.4/no-logo rule: wordmark + role + statement, the same
// anatomy as the masthead, not an invented mark.
const ogImage = new URL('/og-image.png', SITE_URL);

// These MUST stay in sync with the @font-face src URLs in styles/fonts.css.
// A silent mismatch (preloading a file that doesn't exist, or preloading the
// wrong one) degrades quietly rather than erroring, so `pnpm check:fonts`
// asserts all three exist on disk AND are referenced by fonts.css.
//
// Roman faces only, deliberately: these are VARIABLE fonts, so one file
// covers every weight §2.5 uses. Italic is quote-only (§2.5) and not
// above-the-fold critical, so preloading it would cost bandwidth for a face
// most pages never render.
const PRELOAD_FONTS = [
  '/fonts/source-serif-roman.woff2',
  '/fonts/plex-sans-roman.woff2',
  '/fonts/plex-mono-roman.woff2',
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Cascade layer order MUST be established here, literally, before any
         stylesheet reaches the page. Astro bundles component `<style>`
         blocks (e.g. Masthead's `@layer components`) ahead of this layout's
         own `global.css` import — child styles are collected before the
         parent's — so if the canonical order were only declared in
         global.css, `components` would register first (lowest priority) the
         moment any page renders a component with a scoped style, silently
         losing to `reset`/`base`. `is:inline` keeps this exact statement
         un-bundled and un-reordered: it renders verbatim, first. -->
    <style is:inline>
      @layer tokens, reset, base, layout, components, exceptions;
    </style>

    {
      PRELOAD_FONTS.map((href) => (
        <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
      ))
    }

    <script is:inline set:html={themeInitSource} />

    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical.href} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.ico" sizes="32x32" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage.href} />
  </head>

  <body>
    <!-- §18.2: the first focusable element on every page. -->
    <a class="skip-link" href="#main">Skip to content</a>

    <Masthead progress={progress} />

    <!-- tabindex="-1" so the skip link can actually move focus here;
         without it the browser scrolls but focus stays on the link. -->
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
