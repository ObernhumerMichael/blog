---
// ProseLayout — Phase 3.4's minimal stand-in for the real article layout.
//
// NOT Instrumented.astro (IMPLEMENTATION_PLAN.md §3's layout A: the full
// gutter/measure/aside grid, header band, TOC, apparatus). That's Phase
// 5/6's job, once the `writing` collection schema is real. This file does
// exactly one thing: give prose.css's `.prose` class something to attach
// to, so a Markdown page authored with a `layout:` frontmatter key (as the
// Phase 3.1 fixture is) reads correctly ahead of the real page existing.
//
// Also closes a gap flagged back in Phase 3.1: Astro's `layout:` mechanism
// on a `.md` file delivers frontmatter as `Astro.props.frontmatter` (a
// nested object), not spread onto BaseLayout's flat `title`/`description`
// props — so the fixture's `<title>` fell back to the site name. Forwarding
// them here is a two-line fix, now that something actually needs to sit
// between the `.md` file and BaseLayout.
//
// Phase 3.6: now also renders the article header band before .prose.
//
// Phase 3.7: the body is now wrapped in the REAL layout-article grid
// (layout.css §5.2, built in Phase 2.1 and unused until now) instead of
// .prose floating free — not a Phase 5 pull-forward so much as a
// prerequisite: the TOC's own exit criterion ("the article reads correctly
// at all six matrix combinations") is unjudgeable without a real gutter
// column for it to sit in at >=1280, and layout-article's CSS was already
// complete, just waiting for a consumer.
//
// Phase 5.7: the aside is complete now — ArticleAside.astro adds the
// share/reply lines above ReadingProgress's hairline.
//
// Phase 5.8: the apparatus band (author block, prev/next, related) is
// complete too, via ArticleApparatus.astro — the last named gap in the
// header comment above. Still not Instrumented.astro: no collection-backed
// routing lives here, that's /w/[num].astro's job (5.4).
import type { ComponentProps } from 'astro/types';
import BaseLayout from './BaseLayout.astro';
import ArticleHeader from '../components/article/ArticleHeader.astro';
import ArticleToc from '../components/article/ArticleToc.astro';
import ArticleAside from '../components/article/ArticleAside.astro';
import ArticleApparatus, {
  type ApparatusEntry,
} from '../components/article/ArticleApparatus.astro';
import CodeCopy from '../components/article/CodeCopy.svelte';
import TocProgress from '../components/article/TocProgress.svelte';

const {
  frontmatter,
  headings,
  prev = null,
  next = null,
  related = [],
} = Astro.props as {
  frontmatter: ComponentProps<typeof ArticleHeader>['frontmatter'] & {
    numberedHeadingFlags?: boolean[];
  };
  headings: ComponentProps<typeof ArticleToc>['headings'];
  prev?: ApparatusEntry | null;
  next?: ApparatusEntry | null;
  related?: ApparatusEntry[];
};
---

<BaseLayout title={frontmatter.title} description={frontmatter.lead} progress>
  <article>
    <!-- Phase 4.4, ADR-0020: one delegating copy-control island per
         article, not one per code block. `client:visible` hydrates based
         on THIS element's own position, not the code blocks it serves —
         placed at the top of the article (rather than, say, after the
         last block) so it's already in view on load and every block's
         copy button is live immediately, not only once the reader
         scrolls the island itself into view. -->
    <CodeCopy client:visible />
    <!-- Phase 5.6, AD-11: the TOC's scroll-spy and both progress-bar
         renders, one island, same placement reasoning as CodeCopy above. -->
    <TocProgress client:visible />
    <!-- One shared .frame for both bands (not one per component) — layout.css's
         `.band:last-child` rule (no bottom hairline on the last band before
         the footer) checks each band's position among ITS OWN siblings, so a
         band wrapped in a lone `.frame` of its own is always "last" and always
         loses its hairline, whether or not it actually is the page's last
         band. See ArticleHeader.astro's own top-of-file comment. -->
    <div class="frame">
      <ArticleHeader frontmatter={frontmatter} />
      <div class="band layout-article">
        <div class="gutter">
          <ArticleToc
            headings={headings}
            numberedHeadingFlags={frontmatter.numberedHeadingFlags ?? []}
          />
        </div>
        <!-- Not .layout-measure here — .prose sets its own max-width
             (--measure, prose.css) and never needed the class for sizing.
             CORRECTION (Phase 4.0, ADR-0019): this comment previously
             claimed that adding container-type:inline-size directly to
             .prose collapsed it to a 0-width column. That does not
             reproduce — tested again in Chromium 151, both injected at
             runtime and declared statically with a full reload, and
             .prose measured identically to baseline (350/680/680) either
             way, with a @container query correctly matching inside it.
             Whatever was observed originally, it wasn't containment. The
             real reason .prose isn't the E6 container is architectural,
             not a Chromium bug: the measure column is a fixed 680px from
             760 up, which would make the 700px query permanently true.
             The container now lives on .band (layout.css), whose content
             box actually tracks the page width — see that file for the
             350/836/1208 arithmetic. -->
        <!-- .measure-column, not .prose, is the grid's actual 3rd auto-placed
             child now — the apparatus band has to share .prose's column
             (§10's "hairline-separated blocks inside the measure") without
             becoming a 4th grid item, which would push .aside into a second
             row instead of its own column (CSS Grid auto-placement wraps
             once a row's tracks run out). .prose keeps its own max-width
             (Phase 3.7's own comment above), so this wrapper only needs one
             below, for the case below 1280 where .prose's cap doesn't stack
             the two at the same width otherwise. -->
        <div class="measure-column">
          <div class="prose">
            <slot />
          </div>
          <ArticleApparatus
            headings={headings}
            numberedHeadingFlags={frontmatter.numberedHeadingFlags ?? []}
            prev={prev}
            next={next}
            related={related}
          />
        </div>
        <div class="aside">
          <ArticleAside title={frontmatter.title} />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  @layer components {
    .measure-column {
      max-width: var(--measure);
    }
  }
</style>
