---
import { getCollection } from 'astro:content';
import { SITE_NAME, SITE_ROLE, NAV_LINKS, SITE_LINKS } from '../../consts';
import { isCurrentPath } from '../../lib/nav';
import ThemeControl from './ThemeControl.astro';
import MobileMenu from './MobileMenu.svelte';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => isCurrentPath(pathname, href);

// ASSUMPTION (same as last pass, still unverified against consts.ts):
// NAV_LINKS entries optionally carry a `collection` key so counts (§7.5:
// "Writing 38", "Projects 6") can be built here at render time. Entries
// with no collection (About) fall through to null → "—" per §21.2.
const menuLinks = await Promise.all(
  NAV_LINKS.map(async (link) => ({
    href: link.href,
    label: link.label,
    current: isCurrent(link.href),
    count: link.collection ? (await getCollection(link.collection)).length : null,
  })),
);
---

<header class="masthead">
  <div class="frame">
    <div class="row">
      <div class="identity">
        <a href="/" class="wordmark">{SITE_NAME}</a>
        <span class="role">{SITE_ROLE}</span>
      </div>

      <nav class="nav-inline" aria-label="Primary">
        <ul>
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={['nav-link', { current: isCurrent(link.href) }]}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <ThemeControl class="nav-theme" />
      </nav>

      <!-- Mobile (<760), §7.5. Both the trigger and the panel are rendered
           by this one island — see MobileMenu.svelte for why they're kept
           together rather than split further. -->
      <MobileMenu client:load links={menuLinks}>
        <ThemeControl slot="theme" class="menu-theme" showLabel />
        <span slot="meta-links">
          <a href={SITE_LINKS.rss} class="meta-link"
            >rss <span aria-hidden="true">↗</span></a
          >
          <span aria-hidden="true">·</span>
          <a href={SITE_LINKS.github} class="meta-link"
            >github <span aria-hidden="true">↗</span></a
          >
          <span aria-hidden="true">·</span>
          <a href={SITE_LINKS.pgp} class="meta-link"
            >pgp <span aria-hidden="true">↗</span></a
          >
        </span>
      </MobileMenu>
    </div>
  </div>
</header>

<style>
  @layer components {
    .masthead {
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: var(--bw) solid var(--c-rule);
      background: var(--c-bg);
    }

    /* flex-wrap: wrap is the fix. Without it, any flex child that's wider
       than its shrink-fit share (the panel, when open) just squeezes into
       the same line as identity instead of dropping below. With it, plus
       the panel's own flex-basis: 100% (in MobileMenu.svelte), the panel
       is forced onto its own full-width line — normal in-flow content,
       which is what makes it push the page down instead of overlaying it. */
    .row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      padding-block: var(--sp-14);
      padding-inline: var(--page-margin);
    }

    @media (min-width: 760px) {
      .row {
        padding-block: var(--sp-18);
      }
    }
    @media (min-width: 1280px) {
      .row {
        padding-block: var(--sp-20);
      }
    }

    .identity {
      display: flex;
      align-items: baseline;
      gap: var(--sp-12);
      min-width: 0;
    }

    .wordmark {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: var(--fs-wordmark);
      letter-spacing: -0.01em;
      color: var(--c-text);
      text-decoration: none;
      white-space: nowrap;
    }

    .role {
      font-family: var(--font-mono);
      font-size: var(--fs-meta-xs);
      color: var(--c-muted);
      white-space: nowrap;
    }

    @media (max-width: 1279px) {
      .role {
        display: none;
      }
    }

    .nav-inline {
      display: none;
    }

    @media (min-width: 760px) {
      .nav-inline {
        display: flex;
        align-items: center;
        gap: var(--sp-22);
      }
      .nav-inline ul {
        display: flex;
        gap: var(--sp-22);
        list-style: none;
      }
    }
    @media (min-width: 1280px) {
      .nav-inline {
        gap: var(--sp-26);
      }
      .nav-inline ul {
        gap: var(--sp-26);
      }
    }

    .nav-link {
      font-family: var(--font-sans);
      font-size: var(--fs-nav);
      color: var(--c-nav);
      text-decoration: none;
      padding-bottom: 2px;
      border-bottom: 1px solid transparent;
      transition-property: border-color;
      transition-duration: var(--dur);
      transition-timing-function: var(--ease);
    }
    .nav-link:hover {
      border-color: var(--c-accent-hi);
    }
    .nav-link.current {
      color: var(--c-text);
      border-color: var(--c-accent);
    }
    .nav-link:active {
      color: var(--c-accent-hi);
    }

    .meta-link {
      margin-inline: var(--sp-8);
      transition-property: color;
      transition-duration: var(--dur);
      transition-timing-function: var(--ease);
    }

    .meta-link:hover {
      color: var(--c-accent);
    }

    .meta-link:active {
      color: var(--c-accent-hi);
    }
  }
</style>
