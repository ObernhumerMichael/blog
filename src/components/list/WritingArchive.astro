---
// WritingArchive.astro — the shared body of §19.2's Writing index and its
// tag-filtered derivative (IMPLEMENTATION_PLAN.md 6.6: "a tag page IS the
// Writing index with the filter state changed, not a new composition").
// Header (gutter, h1, lead, counted-tag filter row) → optional featured
// band → one band per year → the in-page archive-by-year row. Extracted
// here rather than duplicated across /writing/index.astro and
// /writing/tag/[tag].astro, per 6.6's own "identical logic" framing.
import Tag from '../ui/Tag.astro';
import WritingRow, { type WritingRowEntry } from './WritingRow.astro';
import FeaturedEntry from './FeaturedEntry.astro';
import type { YearGroup } from '../../lib/archive';
import { TAGS, SITE_LINKS } from '../../consts';

type IndexRowEntry = Omit<WritingRowEntry, 'date'> & { date: Date };

export interface Props {
  heading: string;
  lead: string;
  gutterLabel: string;
  gutterSub: string;
  /** Site-wide, not scoped to the current filter — the filter row is
   * global navigation (6.6: "same header band"). */
  siteTotal: number;
  siteTagCounts: Map<string, number>;
  /** The tag rendered `current` in the filter row; absent (index) means
   * the "all" pseudo-tag is current instead. */
  currentTag?: string;
  featured?: IndexRowEntry | null;
  yearGroups: YearGroup<IndexRowEntry>[];
}

const {
  heading,
  lead,
  gutterLabel,
  gutterSub,
  siteTotal,
  siteTagCounts,
  currentTag,
  featured = null,
  yearGroups,
} = Astro.props;
---

<div class="frame">
  <header class="band layout-band">
    <div class="gutter">
      <p class="gutter-label">{gutterLabel}</p>
      <p class="gutter-count">{gutterSub}</p>
    </div>
    <div class="header-content">
      <h1 class="title">{heading}</h1>
      <p class="lead">{lead}</p>
      <!-- §19.2 filter row: "all N" then one counted tag per registry tag
           with a published article, ending with rss ↗. On a tag page the
           matching tag is `current` instead of "all" (6.6 point 2). -->
      <div class="filter-row">
        <Tag tag="all" variant={currentTag ? 'counted' : 'current'} count={siteTotal} />
        {
          TAGS.filter((tag) => (siteTagCounts.get(tag) ?? 0) > 0).map((tag) => (
            <Tag
              tag={tag}
              variant={tag === currentTag ? 'current' : 'counted'}
              count={siteTagCounts.get(tag)}
            />
          ))
        }
        <a class="rss-link" href={SITE_LINKS.rss}>rss <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </header>

  {
    featured && (
      <section class="band layout-band">
        <div class="gutter">
          <p class="gutter-label">Featured</p>
        </div>
        <FeaturedEntry entry={featured} context="index" />
      </section>
    )
  }

  {
    yearGroups.map((group) => (
      <section class="band layout-band" id={String(group.year)}>
        <div class="gutter">
          <p class="gutter-year">{group.year}</p>
          <p class="gutter-count">{group.count}</p>
        </div>
        <div class="year-content">
          {/* §3.6: "Index year header ... sticky row spanning the list"
               below 1280, where the real .gutter above is display:none —
               the column is what goes, the data never does (§3.6's own
               framing), so this is a second render of the same two data
               points, not a CSS relocation of the gutter nodes themselves. */}
          <p class="year-sticky">
            {group.year} · {group.count}
          </p>
          <div class="year-rows">
            {group.entries.map((entry) => (
              <WritingRow entry={entry} variant="full" />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <!-- §19.2 archive row: "archive by year → 2024 (9) 2023 (6) rss ↗",
       resolved (6.5 point 4) as in-page anchors to each year's own band —
       no second page exists to paginate to. -->
  <div class="band layout-band">
    <div class="gutter"></div>
    <p class="archive-row">
      archive by year <span aria-hidden="true">→</span>{' '}
      {
        yearGroups.map((group) => (
          <a href={`#${group.year}`}>
            {group.year} ({group.count})
          </a>
        ))
      }
      <a href={SITE_LINKS.rss}>rss <span aria-hidden="true">↗</span></a>
    </p>
  </div>
</div>

<style>
  @layer components {
    /* layout.css's .gutter only sets text-align — hiding its CONTENT below
       1280 is each consumer's own job (§5.4's own comment; ArticleHeader.astro
       does the same). Of the gutter jobs here, only the year header is
       named in §3.6's relocation table as needing a substitute below 1280
       (the sticky row below); the page-title and "Featured" gutter labels
       aren't in that table and are already carried by content visible at
       every width (the h1, and the "all N" / current tag respectively). */
    .gutter {
      display: none;
    }

    @media (min-width: 1280px) {
      .gutter {
        display: block;
      }
    }

    .gutter-label {
      font: var(--t-gutter);
      color: var(--c-text);
      margin: 0;
    }

    .gutter-count {
      font: var(--t-gutter);
      color: var(--c-faint);
      margin: 0;
    }

    /* §19.2: "the year in serif 22 with the count beneath in --c-faint." */
    .gutter-year {
      font: var(--t-year);
      color: var(--c-text);
      margin: 0;
    }

    /* §3.6: below 1280 the year header leaves the (now display:none)
       gutter and becomes its own sticky row, spanning the list, sitting
       flush under the masthead's own sticky bar — not var(--masthead-h),
       which is only accurate at >=1280 (that token's own comment). */
    .year-sticky {
      display: block;
      position: sticky;
      top: var(--masthead-h-narrow);
      z-index: 5;
      margin: 0;
      padding-block: var(--sp-8);
      background: var(--c-bg);
      border-bottom: var(--bw) solid var(--c-rule-2);
      font: var(--t-label);
      text-transform: uppercase;
      letter-spacing: var(--tr-label);
      color: var(--c-muted);
    }

    @media (min-width: 1280px) {
      .year-sticky {
        display: none;
      }
    }

    .header-content {
      max-width: var(--header-w);
    }

    .title {
      font: var(--t-title);
      color: var(--c-text);
      margin: 0 0 var(--sp-16) 0;
    }

    /* §19.2 states "lead 19px" in prose; the type scale (§2.5) has no
       19px step of its own outside --t-lead's own 760–1279 tablet tier
       (§3.4). Reusing --t-lead — the system's one lead-paragraph token,
       already 20px at this same >=1280 tier — rather than introducing a
       second, near-identical lead size the scale doesn't otherwise
       define; same reasoning ArticleHeader's own lead already applies. */
    .lead {
      font: var(--t-lead);
      color: var(--c-text-2);
      max-width: var(--measure-lead);
      margin: 0 0 var(--sp-24) 0;
      text-wrap: pretty;
    }

    .filter-row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: var(--sp-14);
      row-gap: var(--sp-8);
    }

    .rss-link {
      font: var(--t-meta);
      color: var(--c-muted);
      text-decoration: none;
    }

    .rss-link:hover {
      color: var(--c-accent-hi);
    }

    /* >=1280 only: below that, .year-sticky's own bottom hairline already
       opens the list (§05: "--c-rule-2 opening the group") — a second top
       rule here would double it up against an adjacent sticky element. */
    @media (min-width: 1280px) {
      .year-rows {
        border-top: var(--bw) solid var(--c-rule-2);
      }
    }

    .year-rows > :global(.row) {
      border-bottom: var(--bw) solid var(--c-rule);
    }

    .archive-row {
      font: var(--t-meta);
      color: var(--c-muted);
      margin: 0;
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--sp-14);
      row-gap: var(--sp-8);
    }

    .archive-row a {
      color: var(--c-text);
      text-decoration: none;
    }

    .archive-row a:hover {
      color: var(--c-accent-hi);
      text-decoration: underline;
    }
  }
</style>
