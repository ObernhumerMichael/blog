---
// /writing/index.astro — §19.2, IMPLEMENTATION_PLAN.md 6.5/6.6. The
// Writing index itself: real content-loading (draft filtering, minutesRead,
// featured/year grouping), with the actual bands rendered by
// WritingArchive.astro — shared with /writing/tag/[tag].astro, which is
// "the Writing index with the filter state changed, not a new composition"
// (6.6's own framing).
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingArchive from '../../components/list/WritingArchive.astro';
import type { WritingRowEntry } from '../../components/list/WritingRow.astro';
import { groupByYear, countTags } from '../../lib/archive';
import { COPY } from '../../copy';

// Draft visibility (same rule as /w/[num].astro, /writing/[slug].astro):
// excluded from counts and from the page entirely in production.
const publishedEntries = await getCollection('writing', (e) => !e.data.draft);

// minutesRead is remark-computed, not stored in entry.data (Finding A,
// Phase 5.0) — every published entry needs rendering once to get it, same
// as /w/[num].astro's own withMinutesRead does for a handful of neighbours.
// `date: Date` (narrower than WritingRowEntry's own `Date | string`, which
// exists only for ArticleHeader's fixture-bypass case, 3.1) — the writing
// schema coerces it (z.coerce.date()), so it's always a real Date here,
// which is what groupByYear needs.
type IndexRowEntry = Omit<WritingRowEntry, 'date'> & { date: Date; isFeatured: boolean };
const rowEntries: IndexRowEntry[] = await Promise.all(
  publishedEntries.map(async (entry) => {
    const { remarkPluginFrontmatter } = await render(entry);
    return {
      number: entry.data.number,
      title: entry.data.title,
      lead: entry.data.lead,
      date: entry.data.date,
      minutesRead: remarkPluginFrontmatter.minutesRead as number,
      tags: entry.data.tags,
      section: entry.data.section,
      series: entry.data.series,
      isFeatured: Boolean(entry.data.featured),
    };
  }),
);

const total = rowEntries.length;

// Invariant 2 (tests/invariants/featured.test.ts) guarantees at most one.
const featured = rowEntries.find((e) => e.isFeatured) ?? null;
const nonFeatured = rowEntries.filter((e) => !e.isFeatured);

const tagCounts = countTags(rowEntries);
const yearGroups = groupByYear(nonFeatured);
---

<BaseLayout title="Writing" description={COPY.writing.metaDescription(total)}>
  <WritingArchive
    heading="Writing"
    lead="Articles on backend development and infrastructure automation — what broke, what the fix actually was, and what it cost."
    gutterLabel="Writing"
    gutterSub={`${total} articles`}
    siteTotal={total}
    siteTagCounts={tagCounts}
    featured={featured}
    yearGroups={yearGroups}
  />
</BaseLayout>
