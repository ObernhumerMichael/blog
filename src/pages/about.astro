---
// /about — §19.6, IMPLEMENTATION_PLAN.md 7.5. Four bands: header (bio +
// portrait placeholder), Working on, Experience, Elsewhere. No author
// block (component 09's AuthorBlock is for articles; §19.6 explicitly
// excludes it here — "this page is the author"). None of the four bands
// is a component (§22 rule 8, §23.3 names the 150px period track and the
// four-column Elsewhere grid explicitly as page-local composition).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY } from '../copy';
import portraitPhoto from '../assets/portrait.jpg';

const { experience, elsewhere } = COPY.about;
---

<BaseLayout title="About" description={COPY.about.metaDescription}>
  <div class="frame">
    <header class="band layout-band">
      <div class="gutter">
        <p class="gutter-label">About</p>
        <p class="gutter-count">upd {COPY.about.updated}</p>
      </div>
      <p class="running-head">
        <span>About</span>
        <span>upd {COPY.about.updated}</span>
      </p>
      <div class="header-content">
        <div class="intro">
          <h1 class="title">{COPY.site.name}</h1>
          <p class="bio">{COPY.about.bio[0]}</p>
          <p class="bio bio--muted">{COPY.about.bio[1]}</p>
        </div>
        <div class="portrait">
          <Image src={portraitPhoto} alt="Portrait of Michael Obernhumer" width={200} height={220} />
        </div>
      </div>
    </header>

    <section class="band layout-band">
      <div class="gutter">
        <p class="gutter-label">Working on</p>
        <p class="gutter-count">—</p>
      </div>
      <p class="running-head">
        <span>Working on</span>
        <span>—</span>
      </p>
      <p class="working-on-line">{COPY.about.workingOn.join(' · ')}</p>
    </section>

    <section class="band layout-band">
      <div class="gutter">
        <p class="gutter-label">Experience</p>
        <p class="gutter-count">selected</p>
      </div>
      <p class="running-head">
        <span>Experience</span>
        <span>selected</span>
      </p>
      <div class="exp-rows">
        {
          experience.map((row) => (
            <div class="exp-row">
              <p class="exp-period">{row.period}</p>
              <div class="exp-substance">
                <p class="exp-role">{row.role}</p>
                <p class="exp-desc">{row.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="band layout-band">
      <div class="gutter">
        <p class="gutter-label">Elsewhere</p>
        <p class="gutter-count">—</p>
      </div>
      <p class="running-head">
        <span>Elsewhere</span>
        <span>—</span>
      </p>
      <div class="elsewhere-grid">
        {
          elsewhere.map((entry) => (
            <div class="elsewhere-cell">
              <p class="elsewhere-label">{entry.label}</p>
              {entry.href ? (
                <a class="elsewhere-value" href={entry.href}>
                  {entry.value}
                </a>
              ) : (
                <p class="elsewhere-value elsewhere-value--absent">{entry.value}</p>
              )}
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  @layer components {
    /* Same layout.css's-.gutter-only-sets-text-align precedent every other
       index page uses — hiding the CONTENT below 1280 is this page's own
       job (index.astro's identical comment). Every band's gutter here
       carries a label AND a value neither the h1 nor visible body content
       otherwise repeats, so — like the homepage — every band gets a
       running head, not just one. */
    .gutter {
      display: none;
    }

    @media (min-width: 1280px) {
      .gutter {
        display: block;
      }
    }

    .gutter-label {
      font: var(--t-gutter);
      color: var(--c-text);
      margin: 0;
    }

    .gutter-count {
      font: var(--t-gutter);
      color: var(--c-faint);
      margin: 0;
    }

    .running-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--sp-16);
      font: var(--t-label);
      text-transform: uppercase;
      color: var(--c-muted);
      margin: 0 0 calc(-1 * var(--grid-gap) + var(--sp-16)) 0;
      padding-bottom: var(--sp-12);
      border-bottom: var(--bw) solid var(--c-rule);
    }

    @media (min-width: 1280px) {
      .running-head {
        display: none;
      }
    }

    /* Band 1 — Header. §19.6: "two body-size serif paragraphs beside a
       200x220 portrait." Single column below 760 (portrait drops below
       both paragraphs, per the responsive note), a fixed-width portrait
       column beside the text from 760 up. */
    .header-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--sp-24);
      max-width: var(--header-w);
    }

    @media (min-width: 760px) {
      .header-content {
        grid-template-columns: minmax(0, 1fr) var(--portrait-about);
        column-gap: var(--grid-gap);
        align-items: start;
      }
    }

    .title {
      font: var(--t-title);
      color: var(--c-text);
      margin: 0 0 var(--sp-16) 0;
    }

    .bio {
      font: var(--t-body);
      color: var(--c-text);
      margin: 0 0 var(--sp-24) 0;
      text-wrap: pretty;
    }

    .bio:last-child {
      margin-bottom: 0;
    }

    .bio--muted {
      color: var(--c-text-2);
    }

    /* §14.1's photo framing (same border every figure kind gets, restated
       locally rather than shared since no component covers both this call
       site and FeaturedEntry.astro's .featured-figure — Finding B: this
       page's portrait is page-local composition, not a component). No
       sunken ground — that's screenshot-only (§14.1); a portrait is a
       photo, and photos already fill their frame with real pixel content. */
    .portrait {
      width: var(--portrait-about);
      height: var(--portrait-about-h);
      border: var(--bw) solid var(--c-rule);
      overflow: hidden;
    }

    .portrait img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Band 2 — Working on: §23.3's own named exception, same sans 15/2.0
       treatment as the homepage's Interests line — different content, same
       typography. */
    .working-on-line {
      font: var(--t-ui);
      line-height: 2;
      color: var(--c-text-2);
      margin: 0;
      text-wrap: pretty;
    }

    /* Band 3 — Experience. §19.6 point 3: "150px mono period track beside
       a role title (sans 600 15) and a description (sans 13.5/1.6, max
       66ch)." Stacked period-above-role below 760 per the page's own
       responsive note; a fixed period column from 760 up, matching
       ProjectItem's own track-width convention (component-internal grid,
       not a page-level LAYOUT class, §22.9). */
    .exp-rows {
      border-top: var(--bw) solid var(--c-rule-2);
    }

    .exp-row {
      padding-block: var(--sp-24);
      border-bottom: var(--bw) solid var(--c-rule);
    }

    @media (min-width: 760px) {
      .exp-row {
        display: grid;
        grid-template-columns: var(--about-period-w) minmax(0, 1fr);
        column-gap: var(--sp-24);
      }
    }

    .exp-period {
      font: var(--t-meta);
      color: var(--c-muted);
      margin: 0 0 var(--sp-8) 0;
    }

    @media (min-width: 760px) {
      .exp-period {
        margin: 0;
      }
    }

    /* No --t-* bundle exists for "sans 600 15" — same longhand precedent
       ArticleApparatus.astro's .related-title already sets for a
       component-specific size that doesn't merit its own bundle.
       --fs-ui is reused rather than a new --fs- token: its own ladder
       (14 / 14.5 / 15) already lands on 15px at >=1280, the exact value
       §19.6 names. */
    .exp-role {
      font-family: var(--font-sans);
      font-weight: 600;
      font-size: var(--fs-ui);
      line-height: 1.3;
      color: var(--c-text);
      margin: 0 0 var(--sp-8) 0;
    }

    /* §19.6: "sans 13.5/1.6, max 66ch." --t-small is 13.5px with no
       responsive step, same "nearest declared neighbour" reuse
       --t-author-bio's own comment already argues for, rather than a
       second bundle for a 0.05 line-height difference (1.55 vs 1.6). */
    .exp-desc {
      font: var(--t-small);
      color: var(--c-text-2);
      max-width: var(--measure-about);
      margin: 0;
      text-wrap: pretty;
    }

    /* Band 4 — Elsewhere. §19.6 point 4: "a four-column grid of LABEL
       over value in mono 12/1.9." Responsive: "four -> two -> one
       column." */
    .elsewhere-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--sp-24);
      column-gap: var(--grid-gap);
    }

    @media (min-width: 760px) {
      .elsewhere-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 1280px) {
      .elsewhere-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .elsewhere-label {
      font: var(--t-label);
      text-transform: uppercase;
      color: var(--c-muted);
      margin: 0 0 var(--sp-8) 0;
    }

    .elsewhere-value {
      display: block;
      font: var(--t-project-instr);
      color: var(--c-text);
      text-decoration: none;
      margin: 0;
    }

    .elsewhere-value:hover {
      color: var(--c-accent-hi);
    }

    .elsewhere-value--absent {
      color: var(--c-faint);
    }
  }
</style>
