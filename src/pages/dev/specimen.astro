        <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"
        ></circle>
        <path d="M8 1a7 7 0 0 1 0 14z"></path>
      </svg>
      theme control — inline SVG half-circle, uses currentColor
    </p>

    <script>
      const readout = document.getElementById('theme-readout')!;
      const toggle = document.getElementById('theme-toggle')!;
      readout.textContent = window.__themeInit.currentEffectiveTheme();
      toggle.addEventListener('click', () => {
        window.__themeInit.toggleTheme();
        readout.textContent = window.__themeInit.currentEffectiveTheme();
      });
    </script>
