---
// Phase 1.7 — the specimen page. This is the reference every subsequent
// phase's "does this look right" question gets checked against, instead of
// hunting through real pages. Lives at src/pages/dev/ (no underscore — see
// ADR-0014); excluded from what ships via the deploy-time `rm -rf dist/dev`
// step, not via Astro's routing.
import { getCollection } from 'astro:content';
import '../../styles/global.css';
import themeInitSource from '../../lib/theme-init.js?raw';
import ArticleAside from '../../components/article/ArticleAside.astro';
import ArticleApparatus, {
  type ApparatusEntry,
} from '../../components/article/ArticleApparatus.astro';
import ReadingProgress from '../../components/article/ReadingProgress.astro';
import Tag from '../../components/ui/Tag.astro';
import { findRelated } from '../../lib/related';

// Token lists below were extracted directly from tokens.css via grep, not
// typed from memory — see the Phase 1.7 write-up. Grouped to match
// tokens.css's own section numbering (§ comments in that file) so this page
// and the source stay easy to cross-reference.

const groundTokens = ['--c-bg', '--c-surface', '--c-sunken'];
const textTokens = ['--c-text', '--c-text-2', '--c-muted', '--c-faint', '--c-text-prose'];
const ruleTokens = ['--c-rule', '--c-rule-in', '--c-rule-2'];
const accentTokens = ['--c-accent', '--c-accent-hi', '--c-nav'];
const semanticTokens = ['--c-warn', '--c-warn-bg', '--c-ok'];
const machineTokens = ['--c-code-bg', '--c-term-bg'];
const componentTextTokens = ['--c-callout-text', '--c-quote-text'];

const syntaxTokens = [
  '--code-fg',
  '--term-fg',
  '--syn-comment',
  '--syn-keyword',
  '--syn-string',
  '--syn-literal',
  '--syn-number',
  '--syn-function',
  '--term-prompt',
  '--term-success',
  '--code-linenum',
];
const codeChromeTokens = [
  '--code-chrome-bg',
  '--code-chrome-rule',
  '--code-control-border',
  '--code-filename',
  '--term-chrome-rule',
];
const diffTokens = ['--diff-del-fg', '--diff-del-bg', '--diff-add-fg', '--diff-add-bg'];

const typeTokens = [
  '--t-display',
  '--t-title',
  '--t-h2',
  '--t-h3',
  '--t-lead',
  '--t-body',
  '--t-ui',
  '--t-small',
  '--t-meta',
  '--t-label',
  '--t-code',
  '--t-quote',
  '--t-callout', // added Phase 3.2
];

// Canonical scale first, in the order §2.6 states permitted use, then the
// two families of exceptions kept visually separate since they're allowed
// in different contexts (component-interior only vs. the one grid-gap
// constant).
const spacingCanonical = [
  '--sp-4',
  '--sp-8',
  '--sp-12',
  '--sp-16',
  '--sp-20',
  '--sp-24',
  '--sp-32',
  '--sp-40',
  '--sp-56',
  '--sp-72',
  '--sp-96',
  '--sp-128',
];
const spacingResponsive = ['--sp-26', '--sp-36', '--sp-48'];
const spacingComponentSub = ['--sp-14', '--sp-18', '--sp-22', '--sp-28'];

const glyphs = [
  { char: '→', name: 'internal forward nav' },
  { char: '↗', name: 'external link' },
  { char: '←', name: 'previous in sequence' },
  { char: '·', name: 'datum separator' },
  { char: '/', name: 'breadcrumb separator' },
  { char: '#', name: 'tag prefix' },
  { char: '+', name: 'disclosure closed / diff added' },
  { char: '−', name: 'disclosure open / diff removed' },
];

// Apparatus & aside (Phase 5.11) — real writing entries, not invented data
// (same anti-lorem-ipsum reasoning as the fixture articles, Phase 5.9).
// Article 003 sits mid-sequence with published neighbours on both sides
// and shares tags with two others, so it's the one entry that exercises
// prev, next AND a non-empty related grid at once.
const published = (await getCollection('writing', (e) => !e.data.draft))
  .map((e) => e.data)
  .sort((a, b) => a.number - b.number);
const current = published.find((e) => e.number === 3)!;

// minutesRead needs the remark pipeline's output (render(), Finding A,
// §5.0) — irrelevant to a layout check, so a fixed placeholder stands in
// rather than rendering every entry just to compute a real one.
const toApparatusEntry = (e: typeof current): ApparatusEntry => ({
  number: e.number,
  title: e.title,
  date: e.date,
  minutesRead: 5,
});

const prevData = published.filter((e) => e.number < current.number).at(-1) ?? null;
const nextData = published.find((e) => e.number > current.number) ?? null;
const apparatusPrev = prevData && toApparatusEntry(prevData);
const apparatusNext = nextData && toApparatusEntry(nextData);
const apparatusRelated = findRelated(current, published).map(toApparatusEntry);

// Three numbered h2s — ArticleApparatus's own showAuthorBlock threshold
// (§10.10) — so the author block actually renders instead of gating shut.
const apparatusHeadings = [
  { depth: 2, slug: 'one', text: 'One' },
  { depth: 2, slug: 'two', text: 'Two' },
  { depth: 2, slug: 'three', text: 'Three' },
];
const apparatusFlags = [true, true, true];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Specimen — Ledger tokens</title>
    <script is:inline set:html={themeInitSource} />
    <style>
      body {
        margin: 0;
        padding: 32px;
        background: var(--c-bg);
        color: var(--c-text);
        font: var(--t-ui);
      }
      h1 {
        font: var(--t-title);
        margin: 0 0 8px;
      }
      h2 {
        font: var(--t-h2);
        margin: 48px 0 16px;
        padding-top: 24px;
        border-top: 1px solid var(--c-rule);
      }
      h2:first-of-type {
        border-top: none;
        padding-top: 0;
      }
      .lede {
        font: var(--t-lead);
        color: var(--c-text-2);
        max-width: 60ch;
        margin: 0 0 16px;
      }
      .toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        font: var(--t-meta);
        color: var(--c-muted);
      }
      #theme-toggle {
        font: var(--t-meta);
        padding: 6px 10px;
        cursor: pointer;
        color: var(--c-text);
        background: var(--c-surface);
        border: 1px solid var(--c-rule);
        border-radius: var(--radius-sm);
      }

      .grid {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
      }
      .swatch {
        width: 120px;
      }
      .swatch-fill {
        height: 56px;
        border: 1px solid var(--c-rule);
        border-radius: var(--radius);
      }
      .swatch-name {
        font: var(--t-meta);
        color: var(--c-muted);
        margin-top: 6px;
        word-break: break-all;
      }

      .type-row {
        display: flex;
        align-items: baseline;
        gap: 16px;
        padding: 10px 0;
        border-bottom: 1px solid var(--c-rule-in);
      }
      .type-row .token-name {
        flex: 0 0 140px;
        font: var(--t-meta);
        color: var(--c-accent);
      }
      .type-row .sample {
        color: var(--c-text);
      }

      .ruler {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .ruler-row {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .ruler-bar {
        height: 14px;
        background: var(--c-accent);
        /* No radius — §2.9: radius requires a fill on one of the specific
           surfaces listed there (code block, button, callout, etc.). A
           plain measurement bar isn't one of them, so it stays square. */
      }
      .ruler-label {
        font: var(--t-meta);
        color: var(--c-muted);
        width: 90px;
      }

      .border-demo {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--c-surface);
      }

      .status-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 6px;
      }
      .status-dot.live {
        background: var(--c-ok);
      }
      .status-dot.archived {
        background: transparent;
        border: 1px solid var(--c-muted);
      }

      .theme-glyph {
        width: 16px;
        height: 16px;
        vertical-align: middle;
      }

      .glyph-row {
        display: flex;
        gap: 24px;
        font: var(--t-body);
        flex-wrap: wrap;
      }
      .glyph-row .glyph {
        display: flex;
        align-items: baseline;
        gap: 8px;
      }
      .glyph .char {
        font: var(--t-body);
        color: var(--c-accent);
        width: 1.5em;
        text-align: center;
      }
      .glyph .desc {
        font: var(--t-meta);
        color: var(--c-muted);
      }

      .motion-demo {
        width: 48px;
        height: 24px;
        background: var(--c-rule);
        border-radius: var(--radius-sm);
        transition-property: background-color;
        transition-duration: var(--dur);
        transition-timing-function: var(--ease);
        cursor: pointer;
      }
      .motion-demo:hover {
        background: var(--c-accent);
      }

      .figure-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 24px;
      }
      .figure-row .figure {
        margin: 0;
        flex: 0 1 auto;
      }

      .aside-demo-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 32px;
      }
      .aside-demo {
        width: var(--aside-w, 220px);
      }
      .aside-demo--bare {
        width: 100%;
        max-width: 400px;
      }
      .aside-demo-label {
        font: var(--t-meta);
        color: var(--c-muted);
        margin: 0 0 12px;
      }
      .measure-demo {
        max-width: var(--measure);
      }

      /* §6·08: "12–14px gaps, wrapping flex row" — the container's job, not
         Tag.astro's own (a single tag has no row to wrap). The real filter
         row (6.5) and metadata row (ArticleHeader.astro's `.metadata`) each
         supply this themselves; this is the demo page's own copy of it. */
      .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }
    </style>
  </head>
  <body>
    <h1>Specimen</h1>
    <p class="lede">
      Every token in tokens.css, rendered from the tokens themselves — not reference
      values retyped by hand. If this page looks wrong, the token is wrong; if a real
      component looks wrong but this page looks right, the component is bypassing the
      token system somewhere.
    </p>
    <p class="toolbar">
      <button id="theme-toggle">toggle theme</button>
      effective theme: <strong id="theme-readout">?</strong>
    </p>

    <h2>Grounds</h2>
    <div class="grid">
      {
        groundTokens.map((t) => (
          <div class="swatch">
            <div class="swatch-fill" style={`background: var(${t})`} />
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Text</h2>
    <div class="grid">
      {
        textTokens.map((t) => (
          <div class="swatch">
            <div class="swatch-fill" style={`background: var(${t})`} />
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Rules</h2>
    <div class="grid">
      {
        ruleTokens.map((t) => (
          <div class="swatch">
            <div class="swatch-fill" style={`background: var(${t})`} />
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Accent &amp; nav</h2>
    <div class="grid">
      {
        accentTokens.map((t) => (
          <div class="swatch">
            <div class="swatch-fill" style={`background: var(${t})`} />
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Semantic hues</h2>
    <div class="grid">
      {
        semanticTokens.map((t) => (
          <div class="swatch">
            <div class="swatch-fill" style={`background: var(${t})`} />
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Machine grounds (identical in both themes, E2)</h2>
    <div class="grid">
      {
        machineTokens.map((t) => (
          <div class="swatch">
            <div class="swatch-fill" style={`background: var(${t})`} />
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Component-specific text colours</h2>
    <div class="grid">
      {
        componentTextTokens.map((t) => (
          <div class="swatch">
            <div
              class="swatch-fill"
              style={`background: var(--c-sunken); color: var(${t}); display: flex; align-items: center; justify-content: center; font: var(--t-body);`}
            >
              Aa
            </div>
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Code &amp; syntax palette (constant across themes, §2.3)</h2>
    <div class="grid">
      {
        syntaxTokens.map((t) => (
          <div class="swatch">
            <div
              class="swatch-fill"
              style={`background: var(--code-chrome-bg); color: var(${t}); display: flex; align-items: center; justify-content: center; font: var(--t-code);`}
            >
              Aa1
            </div>
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Code chrome</h2>
    <div class="grid">
      {
        codeChromeTokens.map((t) => (
          <div class="swatch">
            <div class="swatch-fill" style={`background: var(${t})`} />
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Diff (these two hues appear nowhere else in the system, §2.3)</h2>
    <div class="grid">
      {
        diffTokens.map((t) => (
          <div class="swatch">
            <div class="swatch-fill" style={`background: var(${t})`} />
            <div class="swatch-name">{t}</div>
          </div>
        ))
      }
    </div>

    <h2>Type scale</h2>
    <div>
      {
        typeTokens.map((t) => (
          <div class="type-row">
            <span class="token-name">{t}</span>
            <span class="sample" style={`font: var(${t})`}>
              The quick brown fox — Größe, Übung
            </span>
          </div>
        ))
      }
    </div>

    <h2>Spacing — canonical scale (§2.6)</h2>
    <div class="ruler">
      {
        spacingCanonical.map((t) => (
          <div class="ruler-row">
            <span class="ruler-label">{t}</span>
            <div class="ruler-bar" style={`width: var(${t})`} />
          </div>
        ))
      }
    </div>

    <h2>Spacing — responsive steps (§3.3, mobile-only additions)</h2>
    <div class="ruler">
      {
        spacingResponsive.map((t) => (
          <div class="ruler-row">
            <span class="ruler-label">{t}</span>
            <div class="ruler-bar" style={`width: var(${t})`} />
          </div>
        ))
      }
    </div>

    <h2>Spacing — component interior sub-steps (E13, inside components only)</h2>
    <div class="ruler">
      {
        spacingComponentSub.map((t) => (
          <div class="ruler-row">
            <span class="ruler-label">{t}</span>
            <div class="ruler-bar" style={`width: var(${t})`} />
          </div>
        ))
      }
    </div>

    <h2>Spacing — the one exception (E1)</h2>
    <div class="ruler">
      <div class="ruler-row">
        <span class="ruler-label">--grid-gap</span>
        <div class="ruler-bar" style="width: var(--grid-gap)"></div>
      </div>
    </div>

    <h2>Borders &amp; radius (§2.8, §2.9)</h2>
    <div class="grid">
      <div class="swatch">
        <div class="border-demo" style="border: var(--bw) solid var(--c-rule);">1px</div>
        <div class="swatch-name">--bw</div>
      </div>
      <div class="swatch">
        <div
          class="border-demo"
          style="border-left: var(--bw-marker) solid var(--c-accent);"
        >
          2px
        </div>
        <div class="swatch-name">--bw-marker (marker only)</div>
      </div>
      <div class="swatch">
        <div
          class="border-demo"
          style="border: var(--bw) solid var(--c-rule); border-radius: var(--radius); background: var(--c-code-bg);"
        >
        </div>
        <div class="swatch-name">--radius (4px)</div>
      </div>
      <div class="swatch">
        <div
          class="border-demo"
          style="border: var(--bw) solid var(--c-rule); border-radius: var(--radius-sm); background: var(--c-sunken);"
        >
        </div>
        <div class="swatch-name">--radius-sm (3px)</div>
      </div>
      <div class="swatch">
        <div
          class="border-demo"
          style="border-radius: 50%; background: var(--c-ok); width: 24px; height: 24px;"
        >
        </div>
        <div class="swatch-name">50% (status dot only)</div>
      </div>
    </div>

    <h2>Motion (§2.12, §17.5 — hover, or check with reduced-motion on)</h2>
    <div class="motion-demo"></div>

    <h2>Focus (§2.13 — tab to this button)</h2>
    <button id="focus-demo" style="font: var(--t-ui); padding: 8px 14px;">
      tab to me
    </button>

    <h2>Prose components (§6·10, §10, §11) — added Phase 3.9</h2>
    <p class="lede" style="font-size: 13.5px;">
      Every <code>--t-*</code> bundle above is rendered directly on a token, so a wrong value
      is caught immediately. Component-local sizes like
      <code>--fs-callout</code> have no such bundle to sit beside — the only way a wrong one
      shows up is a real component rendered wrong, which is exactly what 3.2's mobile callout
      bug slipped past. This section is that check.
    </p>
    <div class="prose">
      <p>
        A prose paragraph, same as any other, with an <a href="/writing/">
          inline link</a
        >, an <a href="https://example.com/">external link&#8202;↗</a>, some <code
          >inline code</code
        >, and a footnote reference<sup
          ><a data-footnote-ref href="#specimen-fn-1">1</a></sup
        >.
      </p>

      <div class="callout callout--note" data-callout="note">
        <p class="callout__label">NOTE</p>
        <div class="callout__body">
          <p>
            The default callout kind — accent marker, sunken ground. Body text renders in <code
              >--t-callout</code
            >, not <code>--t-body</code>.
          </p>
        </div>
      </div>

      <div class="callout callout--warning" data-callout="warning">
        <p class="callout__label">WARNING</p>
        <div class="callout__body">
          <p>
            Warning and correction share the same treatment: marker and label switch to <code
              >--c-warn</code
            >, ground switches to
            <code>--c-warn-bg</code>.
          </p>
        </div>
      </div>

      <div class="callout callout--correction" data-callout="correction">
        <p class="callout__label">CORRECTION</p>
        <div class="callout__body">
          <p>Same treatment as warning — the two are visually identical.</p>
        </div>
      </div>

      <blockquote>
        <p>
          Idempotent means it doesn't break what's already there. Reproducible means I can
          tell you, in advance, exactly what will be there.
        </p>
        <p>— a quote with attribution, mono, muted, beneath the text</p>
      </blockquote>
    </div>

    <h2>Code, terminal, figures &amp; tables (§13, §14, §15) — added Phase 4.11</h2>
    <p class="lede" style="font-size: 13.5px;">
      Same job as 3.9, one section behind it: the four block kinds render here even where
      no shipped fixture combines their states. <code>.diff-del</code> and <code
        >.term-block__success</code
      > are real classes (<code>code.css</code>, <code>rehype-terminal.ts</code>) that no
      committed fixture had triggered until this page did — a diff hunk that only ever
      adds, and a terminal block that never succeeds, are exactly the kind of gap 3.2's
      callout bug came from.
    </p>
    <div class="prose">
      <figure class="code-block">
        <div class="code-block__chrome">
          <span class="code-block__filename"
            >ansible/roles/base/templates/hostname.j2</span
          >
          <div class="code-block__meta">
            <span class="code-block__lang">jinja</span>
            <button type="button" hidden class="code-block__copy" data-copy=""
              >copy</button
            >
          </div>
        </div>
        <div class="code-block__body">
          <pre
            class="astro-code ledger"
            style="background-color:var(--c-code-bg);color:var(--code-fg); overflow-x: auto;"
            tabindex="0"
            data-language="jinja"><code><span class="line"><span style="color:var(--code-fg)">{'{{ inventory_hostname }}'}</span></span></code></pre>
        </div>
      </figure>
      <p class="code-block__caption">
        Listing 1 — Twelve lines or fewer: no gutter (§13.2).
      </p>

      <figure class="code-block">
        <div class="code-block__chrome">
          <span class="code-block__filename">ansible/roles/monitoring/tasks/main.yml</span
          >
          <div class="code-block__meta">
            <span class="code-block__lang">yaml</span>
            <button type="button" hidden class="code-block__copy" data-copy=""
              >copy</button
            >
          </div>
        </div>
        <div class="code-block__body">
          <div class="code-block__gutter" aria-hidden="true">
            <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span
              >6</span
            ><span>7</span><span>8</span><span>9</span><span>10</span><span>11</span><span
              >12</span
            ><span>13</span><span>14</span><span>15</span><span>16</span><span>17</span
            ><span>18</span><span>19</span><span>20</span><span>21</span>
          </div>
          <pre
            class="astro-code ledger"
            style="background-color:var(--c-code-bg);color:var(--code-fg); overflow-x: auto;"
            tabindex="0"
            data-language="yaml"><code><span class="line"><span style="color:var(--code-fg)">---</span></span>
<span class="line"><span style="color:var(--code-fg)">- </span><span style="color:var(--syn-keyword)">name</span><span style="color:var(--syn-keyword)">:</span><span style="color:var(--syn-string)"> Install node_exporter</span></span>
<span class="line"><span style="color:var(--syn-keyword)">  ansible.builtin.apt</span><span style="color:var(--syn-keyword)">:</span></span>
<span class="line"><span style="color:var(--syn-keyword)">    name</span><span style="color:var(--syn-keyword)">:</span><span style="color:var(--syn-string)"> prometheus-node-exporter</span></span>
