---
// /projects/index.astro — §11.1/§19.4, IMPLEMENTATION_PLAN.md 6.8. Layout
// B throughout: header band (gutter, h1, lead) → an INDEX-labelled band of
// ProjectItems, 26px padding-y (ProjectItem's own), `--c-rule-2` opening
// the list, `--c-rule` between items (ProjectItem's own bottom hairline).
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectItem from '../../components/list/ProjectItem.astro';

// Draft visibility, same rule as every other collection read in the
// codebase: excluded from counts and from the page entirely in production.
const publishedEntries = await getCollection('projects', (e) => !e.data.draft);
const published = publishedEntries.map((e) => e.data).sort((a, b) => a.number - b.number);

const total = published.length;
const activeCount = published.filter((p) => p.status === 'active').length;
---

<BaseLayout
  title="Projects"
  description="Projects worth writing about — what each one is, why it exists and what it is built from."
>
  <div class="frame">
    <header class="band layout-band">
      <div class="gutter">
        <p class="gutter-label">Projects</p>
        <p class="gutter-count">
          {total} · {activeCount} active
        </p>
      </div>
      <div class="header-content">
        <h1 class="title">Projects</h1>
        <p class="lead">
          Each entry states what it is, why it exists and what it is built from; the case
          studies go into architecture and the decisions that turned out to be wrong.
        </p>
      </div>
    </header>

    <section class="band layout-band">
      <div class="gutter">
        <p class="gutter-label">Index</p>
      </div>
      <div class="project-rows">
        {published.map((project) => <ProjectItem entry={project} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  @layer components {
    /* layout.css's .gutter only sets text-align — hiding its content below
       1280 is each consumer's own job (ArticleHeader.astro's own pattern,
       restated by /writing/index.astro's WritingArchive.astro). Neither
       gutter job here has a named relocation in §3.6's table (that table
       is specific to the article/index-row spine) and both are already
       carried by content visible at every width (the h1, and each item's
       own number, ProjectItem.astro). */
    .gutter {
      display: none;
    }

    @media (min-width: 1280px) {
      .gutter {
        display: block;
      }
    }

    .gutter-label {
      font: var(--t-gutter);
      color: var(--c-text);
      margin: 0;
    }

    .gutter-count {
      font: var(--t-gutter);
      color: var(--c-faint);
      margin: 0;
    }

    .header-content {
      max-width: var(--header-w);
    }

    .title {
      font: var(--t-title);
      color: var(--c-text);
      margin: 0 0 var(--sp-16) 0;
    }

    .lead {
      font: var(--t-lead);
      color: var(--c-text-2);
      max-width: var(--measure-lead);
      margin: 0;
      text-wrap: pretty;
    }

    /* No rule opens the list and none closes it — only the hairlines
       between entries (each ProjectItem's own --c-rule bottom border,
       component 07) should show. The last item's own border-bottom is
       switched off here rather than in ProjectItem.astro, since that
       component has no way to know it's last; :global() reaches its
       scoped `.item` class from this parent, same technique
       WritingArchive.astro already uses for `.year-rows > :global(.row)`. */
    .project-rows > :global(.item):last-child {
      border-bottom: none;
    }
  }
</style>
