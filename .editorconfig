root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown: trailing double-space is a hard line break in some renderers.
# Don't strip it blindly.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab