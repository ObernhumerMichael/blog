# pnpm strictness settings.
# Reasoning: a non-hoisted, strict node_modules means a package that's used in
# code but not declared in package.json fails immediately at install/build
# time, rather than working locally (because some OTHER dependency happened to
# hoist it) and then breaking in CI or on a fresh clone. Same category of bug
# T1–T5 exist to catch elsewhere in this repo — catch it in dependencies too.

# Do not hoist anything to the root node_modules by default.
shamefully-hoist=false

# Use the exact versions resolved, not a range, when adding new dependencies —
# makes `pnpm add` deterministic and diffs reviewable.
save-exact=true

# Pin the engine check so a mismatched local Node version fails loudly instead
# of producing a subtly different build.
engine-strict=true
